# 환경 모드 설정
# development: 개발 모드 (로컬 테스트, 상세 로그)
# production: 서비스 모드 (실제 운영, 최소 로그)
ENVIRONMENT=production

# Resend API Key
# https://resend.com/api-keys 에서 발급받은 API Key를 입력하세요
RESEND_API_KEY=REDACTED_RESEND_KEY

# 오류 보고를 받을 이메일 주소
ERROR_REPORT_EMAIL=neohum77@gmail.com

# 발신자 이메일 (Resend에서 인증된 도메인 필요)
# 예: noreply@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com



# 디버그 모드 (true/false)
DEBUG=true

# 관리자 계정 (로컬 접근만 허용)
ADMIN_USERNAME=neohum
ADMIN_PASSWORD=min9610012@@
JWT_SECRET=your-secret-key-change-this-in-production

# OpenAI API 설정 (자동 오류 수정)
# https://platform.openai.com/api-keys 에서 API 키를 발급받으세요
# 모델: gpt-4o-mini (빠르고 저렴)
OPENAI_API_KEY=your-openai-api-key-here

# 하위 호환성 (기존 AUGMENT_API_KEY도 지원)
AUGMENT_API_KEY=REDACTED_GH_PAT

