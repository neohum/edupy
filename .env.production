# 환경 모드 설정
# production: 서비스 모드 (실제 운영, 최소 로그)
ENVIRONMENT=production

# Resend API Key
# https://resend.com/api-keys 에서 발급받은 API Key를 입력하세요
RESEND_API_KEY=

# 오류 보고를 받을 이메일 주소
ERROR_REPORT_EMAIL=neohum77@gmail.com

# 발신자 이메일 (Resend에서 인증된 도메인 필요)
# 프로덕션에서는 반드시 인증된 도메인 사용
FROM_EMAIL=noreply@edupy.dev

# CORS 설정 (실제 서비스 도메인)
# 여러 도메인은 쉼표로 구분: https://edupy.dev,https://www.edupy.dev
CORS_ORIGINS=https://edupy.dev

# 디버그 모드 (프로덕션에서는 false)
DEBUG=false

# 관리자 계정 설정 (create_admin.py 실행 시 사용)
# 보안을 위해 강력한 비밀번호를 사용하세요
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database: Using SQLite (default: backend/edupy.db)
# No DATABASE_URL configuration needed

# Anthropic Claude API (AI 팀 오류 수정)
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=your-anthropic-api-key-here
