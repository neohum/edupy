# 환경 모드 설정
# development: 개발 모드 (로컬 테스트, 상세 로그)
# production: 서비스 모드 (실제 운영, 최소 로그)
ENVIRONMENT=development

# 데이터베이스 설정
# SQLite 사용 (기본값, 설정하지 않으면 자동으로 SQLite 사용)
# DATABASE_URL=sqlite:///app/edupy.db

# PostgreSQL 사용 (호스트에 설치된 경우)
# 개발 환경 (macOS/Linux):
# DATABASE_URL=postgresql://edupy_user:your_password@host.docker.internal:5432/edupy
#
# 서버 환경 (Linux):
# DATABASE_URL=postgresql://edupy_user:your_password@host.docker.internal:5432/edupy
#
# 원격 PostgreSQL:
# DATABASE_URL=postgresql://edupy_user:your_password@server-ip:5432/edupy

# Resend API Key
# https://resend.com/api-keys 에서 발급받은 API Key를 입력하세요
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 오류 보고를 받을 이메일 주소
ERROR_REPORT_EMAIL=neohum77@gmail.com

# 발신자 이메일 (Resend에서 인증된 도메인 필요)
# 예: noreply@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com

# CORS 설정 (개발/서비스 모드에 따라 다름)
# 개발: http://localhost:5173
# 서비스: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173

# 디버그 모드 (true/false)
DEBUG=true

# 관리자 계정 설정 (create_admin.py 실행 시 사용)
# 보안을 위해 강력한 비밀번호를 사용하세요
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

